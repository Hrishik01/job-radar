{
  "titles": {
    "keep": [
      "business analyst", "data analyst", "data scientist", "analytics",
      "business intelligence", "revenue operations", "sales operations",
      "commercial operations", "business operations", "strategy analyst",
      "insights analyst", "reporting analyst", "analytics engineer",
      "bi engineer", "business systems analyst", "operations analyst", "product analyst",
      "associate analyst", "associate consultant", "analyst i", "junior analyst",
      "entry level analyst", "new grad"
    ],
    "drop": [
      "senior", "sr", "lead", "manager", "principal", "staff", "director",
      "head of", "vp", "avp", "vice president", "architect",
      "intern", "internship", "co-op", "mba"
    ],
    "drop_unless": {
      "engineer": ["analytics engineer", "bi engineer", "business intelligence engineer"]
    }
  },
  "max_years_required": 3,

  "bands": {
    "_note": "Every kept job is 'target' or 'stretch'. Stretch: minimum required years >= stretch_years, or a stretch_title pattern (case-sensitive). Otherwise target; target_title patterns (case-insensitive) are recorded as reasons. Senior/Sr./Principal are dropped by titles.drop before banding.",
    "stretch_years": 3,
    "stretch_title": {
      "level II/III": "\\b(?:II|III)\\b"
    },
    "target_title": {
      "Analyst I": "\\banalyst i\\b(?!i)",
      "Associate": "\\bassociate\\b",
      "new grad": "\\bnew grad(?:uate)?\\b",
      "entry level": "\\bentry[- ]level\\b",
      "early career": "\\bearly[- ]career\\b",
      "junior": "\\bjunior\\b|\\bjr\\.?(?=\\s)"
    }
  },

  "people_search": {
    "_note": "Keywords for the dashboard's Find people links (LinkedIn and Google search URLs; nothing is fetched). manager: [title regex, phrases] pairs, first match wins.",
    "manager": [
      ["data scien|machine learning", ["data science manager", "head of data science", "director of data science"]],
      ["business intelligence|\\bBI\\b|reporting", ["BI manager", "business intelligence manager", "head of BI"]],
      ["analytics engineer|data engineer", ["analytics engineering manager", "data engineering manager", "head of data"]],
      ["revenue operations|sales operations|commercial operations", ["revenue operations manager", "head of revenue operations", "sales operations manager"]],
      ["product analy", ["product analytics manager", "head of product analytics"]],
      ["business operations|operations analyst|strategy", ["business operations manager", "head of business operations", "strategy and operations manager"]],
      ["research|clinical", ["research manager", "principal investigator", "research program manager"]],
      ["business systems|business analyst", ["business analysis manager", "head of business analysis", "analytics manager"]]
    ],
    "default_manager": ["analytics manager", "head of data", "head of analytics"],
    "recruiter": ["recruiter", "talent acquisition", "university recruiting"],
    "alumni": "Northeastern"
  },

  "cap_exempt_employers": [
